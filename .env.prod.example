# ── Database ──────────────────────────────────────────────────────────
POSTGRES_DB=duar
POSTGRES_USER=duar
POSTGRES_PASSWORD=          # openssl rand -base64 24

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PASSWORD=             # openssl rand -base64 24
# REDIS_TLS_CA_CERT=        # Path to CA cert if using private CA (e.g. /certs/redis-ca.crt)
REDIS_TLS_VERIFY=required   # "required" (verify cert) or "none" (encrypt only, skip verify)

# ── URLs ──────────────────────────────────────────────────────────────
# Public URL of the Duar auth service (used to build OAuth callback URLs)
BASE_URL=https://auth.example.com
# Public URL of the admin panel (redirects after admin login/logout)
ADMIN_URL=https://admin.example.com
# ALLOWED_HOSTS is derived from BASE_URL + ADMIN_URL automatically.
# Override only if you need additional hostnames (comma-separated).
# ALLOWED_HOSTS=

# Base CORS origins (comma-separated)
# Client app redirect URIs are automatically added at runtime.
# Only list origins here that aren't registered as client apps (e.g. admin panel).
CORS_ORIGINS=https://admin.example.com

# ── Security ──────────────────────────────────────────────────────────
SESSION_SECRET_KEY=         # python -c "import secrets; print(secrets.token_urlsafe(32))"
# Behind a reverse proxy? Set BEHIND_PROXY=true and TRUSTED_PROXY_COUNT to the
# number of proxies between Duar and the internet (1 = a single nginx/ALB).
# The client IP is read from that hop of X-Forwarded-For so it cannot be spoofed.
BEHIND_PROXY=false
TRUSTED_PROXY_COUNT=1
# Service apps are now managed via the admin panel (DB-based).
# Register service apps at /admin/service-apps after deploying.

# ── Rate Limiting (optional; defaults shown) ─────────────────────────
# Per-IP tiers passed through by docker-compose.prod.yml. Aggregate is the
# volumetric ceiling for undecorated routes ("" disables it). Decorated auth/
# admin routes are NOT covered by it — run edge rate limiting (nginx/CDN/ALB)
# in front of Duar. See docs/security.md.
# RATE_LIMIT_AGGREGATE=300/minute
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_AUTHZ_RESOLVE=60/minute

# ── Security Signals (optional; defaults shown) ──────────────────────
# Detect-only anomaly flags (impossible travel, new country/device, credential
# stuffing) surfaced in the admin Activity/Dashboard. Never block auth.
# SIGNALS_ENABLED=true
# SIGNAL_IMPOSSIBLE_TRAVEL_KMH=900
# SIGNAL_STUFFING_WINDOW_MINUTES=15
# SIGNAL_STUFFING_FAILURES=10
# SIGNAL_STUFFING_DISTINCT_EMAILS=5

# ── OAuth Providers (uncomment as needed) ─────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=

# ── Admin ─────────────────────────────────────────────────────────────
ADMIN_EMAILS=               # comma-separated emails auto-promoted to admin

# ── JWT Signing Keys ──────────────────────────────────────────────────
# JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH default to keys/private.pem and
# keys/public.pem — the current signing key. Issued tokens carry a `kid`.
# During rotation, move the previous public key here (comma-separated) and keep
# it for at least REFRESH_TOKEN_EXPIRE_DAYS, then remove it. Runbook:
# docs/deployment/key-rotation.md
JWT_PREVIOUS_PUBLIC_KEY_PATHS=

# ── Token Lifetimes ──────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO          # DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_FORMAT=json         # json (prod) | console (dev)
LOG_PII_REDACTION=true  # mask emails/secrets in logs

# ── Container ─────────────────────────────────────────────────────────
DUAR_PORT=9003
ADMIN_PORT=9004
